[Unit]
Description=AI Workbench Prometheus and hardware monitoring
Wants=ai-workbench-gateway.service
After=ai-workbench-gateway.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/mnt/Code/llm-backend
ExecStart=/mnt/Code/llm-backend/lab monitor start
ExecStop=/mnt/Code/llm-backend/lab monitor stop
TimeoutStartSec=120
TimeoutStopSec=60

[Install]
WantedBy=default.target
