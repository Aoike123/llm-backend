# Copy to ~/.config/ai-workbench/public-tunnel.env (mode 600).
INFERENCE_PORT=18982
PUBLIC_API_SSH_TARGET=api-tunnel@YOUR_SERVER_IP
PUBLIC_API_SSH_PORT=22
PUBLIC_API_SSH_IDENTITY=/absolute/path/to/runtime_ed25519
PUBLIC_API_SSH_KNOWN_HOSTS=/absolute/path/to/verified/known_hosts
PUBLIC_API_REMOTE_PORT=28984
