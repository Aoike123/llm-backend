(inference_proxy) {
    reverse_proxy 127.0.0.1:28984 {
        header_up X-Workbench-Public 1
        flush_interval -1
        transport http {
            dial_timeout 5s
            response_header_timeout 1900s
            read_timeout 1900s
            write_timeout 60s
            keepalive off
        }
    }
}

# Add this site block to the server's existing Caddy configuration.
api.example.com {
    request_body {
        max_size 33554432
    }
    @inference {
        path /v1/models /v1/media/models /v1/chat/completions /v1/images/generations /v1/images/edits /v1/videos/generations
    }
    @artifact path_regexp artifact ^/artifacts/[a-f0-9]{32}\.mp4$
    handle @inference {
        import inference_proxy
    }
    handle @artifact {
        import inference_proxy
    }
    handle {
        respond 404
    }
}

