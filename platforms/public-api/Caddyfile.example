(inference_proxy) {
    reverse_proxy 127.0.0.1:28984 {
        header_up X-Workbench-Public 1
        flush_interval -1
        transport http {
            dial_timeout 5s
            response_header_timeout 1900s
            read_timeout 1900s
            write_timeout 60s
            keepalive off
        }
    }
}

# Add this site block to the server's existing Caddy configuration.
api.example.com {
    request_body {
        max_size 33554432
    }
    # Everything under /v1 and /artifacts goes to the gateway. The gateway decides: it serves only the
    # public routes switched on in the console (and requires a key); anything else it answers 404.
    @gateway path /v1/* /artifacts/*
    handle @gateway {
        import inference_proxy
    }
    handle {
        respond 404
    }
}

